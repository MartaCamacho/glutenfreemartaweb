# Long-lived Instagram token for the home page feed.
# Expires 60 days after it is issued or last refreshed: npm run instagram:refresh
# Without it the feed falls back to the frozen posts in lib/instagram-fallback.ts.
INSTAGRAM_ACCESS_TOKEN=

# Published-CSV URL of the Amazon recommendations sheet — see the README.
# Without it the Amazon section on /links does not render at all.
AMAZON_PICKS_SHEET_URL=
